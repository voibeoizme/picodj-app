<?xml version="1.0" encoding="utf-8"?>
<MixxxControllerPreset mixxxVersion="2.5.0+" schemaVersion="1">
    <info>
        <name>PicoDJ Bàn DJ ver 2</name>
        <author>Nguyên</author>
        <description>Bàn DJ tự chế dùng Raspberry Pi Pico (CircuitPython / Pico SDK), USB + BLE MIDI. 2 deck: Play, Cue, Sync, Load, Pitch Bend ±, EQ 3 băng, Color FX, channel fader, 2 Beat FX, encoder duyệt thư viện. Bố cục giống mapping Rekordbox "Bàn DJ ver 2.csv".</description>
    </info>
    <controller id="PicoDJ">
        <scriptfiles>
            <file filename="PicoDJ-scripts.js" functionprefix="PicoDJ"/>
        </scriptfiles>
        <controls>
            <control>
                <description>Deck 1 Pitch Bend -</description>
                <group>[Channel1]</group>
                <key>rate_temp_down</key>
                <status>0x90</status>
                <midino>0x3C</midino>
                <options>
                    <normal/>
                </options>
            </control>
            <control>
                <description>Deck 1 Pitch Bend +</description>
                <group>[Channel1]</group>
                <key>rate_temp_up</key>
                <status>0x90</status>
                <midino>0x49</midino>
                <options>
                    <normal/>
                </options>
            </control>
            <control>
                <description>Deck 1 Sync</description>
                <group>[Channel1]</group>
                <key>PicoDJ.sync</key>
                <status>0x90</status>
                <midino>0x3D</midino>
                <options>
                    <script-binding/>
                </options>
            </control>
            <control>
                <description>Deck 1 Cue (CDJ mode)</description>
                <group>[Channel1]</group>
                <key>cue_default</key>
                <status>0x90</status>
                <midino>0x3E</midino>
                <options>
                    <normal/>
                </options>
            </control>
            <control>
                <description>Deck 1 Play/Pause</description>
                <group>[Channel1]</group>
                <key>PicoDJ.play</key>
                <status>0x90</status>
                <midino>0x3F</midino>
                <options>
                    <script-binding/>
                </options>
            </control>
            <control>
                <description>Deck 1 Load</description>
                <group>[Channel1]</group>
                <key>LoadSelectedTrack</key>
                <status>0x90</status>
                <midino>0x42</midino>
                <options>
                    <normal/>
                </options>
            </control>
            <control>
                <description>Deck 2 Pitch Bend -</description>
                <group>[Channel2]</group>
                <key>rate_temp_down</key>
                <status>0x90</status>
                <midino>0x40</midino>
                <options>
                    <normal/>
                </options>
            </control>
            <control>
                <description>Deck 2 Pitch Bend +</description>
                <group>[Channel2]</group>
                <key>rate_temp_up</key>
                <status>0x90</status>
                <midino>0x4A</midino>
                <options>
                    <normal/>
                </options>
            </control>
            <control>
                <description>Deck 2 Sync</description>
                <group>[Channel2]</group>
                <key>PicoDJ.sync</key>
                <status>0x90</status>
                <midino>0x41</midino>
                <options>
                    <script-binding/>
                </options>
            </control>
            <control>
                <description>Deck 2 Cue (CDJ mode)</description>
                <group>[Channel2]</group>
                <key>cue_default</key>
                <status>0x90</status>
                <midino>0x44</midino>
                <options>
                    <normal/>
                </options>
            </control>
            <control>
                <description>Deck 2 Play/Pause</description>
                <group>[Channel2]</group>
                <key>PicoDJ.play</key>
                <status>0x90</status>
                <midino>0x45</midino>
                <options>
                    <script-binding/>
                </options>
            </control>
            <control>
                <description>Deck 2 Load</description>
                <group>[Channel2]</group>
                <key>LoadSelectedTrack</key>
                <status>0x90</status>
                <midino>0x43</midino>
                <options>
                    <normal/>
                </options>
            </control>
            <control>
                <description>Deck 1 EQ High</description>
                <group>[EqualizerRack1_[Channel1]_Effect1]</group>
                <key>parameter3</key>
                <status>0xB0</status>
                <midino>0x0A</midino>
                <options>
                    <soft-takeover/>
                </options>
            </control>
            <control>
                <description>Deck 1 EQ Mid</description>
                <group>[EqualizerRack1_[Channel1]_Effect1]</group>
                <key>parameter2</key>
                <status>0xB0</status>
                <midino>0x0B</midino>
                <options>
                    <soft-takeover/>
                </options>
            </control>
            <control>
                <description>Deck 1 EQ Low</description>
                <group>[EqualizerRack1_[Channel1]_Effect1]</group>
                <key>parameter1</key>
                <status>0xB0</status>
                <midino>0x0C</midino>
                <options>
                    <soft-takeover/>
                </options>
            </control>
            <control>
                <description>Deck 1 Color FX</description>
                <group>[QuickEffectRack1_[Channel1]]</group>
                <key>super1</key>
                <status>0xB0</status>
                <midino>0x0D</midino>
                <options>
                    <soft-takeover/>
                </options>
            </control>
            <control>
                <description>Deck 1 Channel fader</description>
                <group>[Channel1]</group>
                <key>volume</key>
                <status>0xB0</status>
                <midino>0x16</midino>
                <options>
                    <soft-takeover/>
                </options>
            </control>
            <control>
                <description>Deck 2 EQ High</description>
                <group>[EqualizerRack1_[Channel2]_Effect1]</group>
                <key>parameter3</key>
                <status>0xB0</status>
                <midino>0x0E</midino>
                <options>
                    <soft-takeover/>
                </options>
            </control>
            <control>
                <description>Deck 2 EQ Mid</description>
                <group>[EqualizerRack1_[Channel2]_Effect1]</group>
                <key>parameter2</key>
                <status>0xB0</status>
                <midino>0x0F</midino>
                <options>
                    <soft-takeover/>
                </options>
            </control>
            <control>
                <description>Deck 2 EQ Low</description>
                <group>[EqualizerRack1_[Channel2]_Effect1]</group>
                <key>parameter1</key>
                <status>0xB0</status>
                <midino>0x10</midino>
                <options>
                    <soft-takeover/>
                </options>
            </control>
            <control>
                <description>Deck 2 Color FX</description>
                <group>[QuickEffectRack1_[Channel2]]</group>
                <key>super1</key>
                <status>0xB0</status>
                <midino>0x11</midino>
                <options>
                    <soft-takeover/>
                </options>
            </control>
            <control>
                <description>Deck 2 Channel fader</description>
                <group>[Channel2]</group>
                <key>volume</key>
                <status>0xB0</status>
                <midino>0x17</midino>
                <options>
                    <soft-takeover/>
                </options>
            </control>
            <control>
                <description>Color FX select</description>
                <group>[QuickEffectRack1_[Channel1]]</group>
                <key>PicoDJ.cfxSelect</key>
                <status>0x90</status>
                <midino>0x46</midino>
                <options>
                    <script-binding/>
                </options>
            </control>
            <control>
                <description>FX1-1 level</description>
                <group>[EffectRack1_EffectUnit1_Effect1]</group>
                <key>meta</key>
                <status>0xB0</status>
                <midino>0x13</midino>
                <options>
                    <soft-takeover/>
                </options>
            </control>
            <control>
                <description>FX1-1 on</description>
                <group>[EffectRack1_EffectUnit1_Effect1]</group>
                <key>PicoDJ.fxOn</key>
                <status>0x90</status>
                <midino>0x48</midino>
                <options>
                    <script-binding/>
                </options>
            </control>
            <control>
                <description>FX2-1 level</description>
                <group>[EffectRack1_EffectUnit2_Effect1]</group>
                <key>meta</key>
                <status>0xB0</status>
                <midino>0x12</midino>
                <options>
                    <soft-takeover/>
                </options>
            </control>
            <control>
                <description>FX2-1 on</description>
                <group>[EffectRack1_EffectUnit2_Effect1]</group>
                <key>PicoDJ.fxOn</key>
                <status>0x90</status>
                <midino>0x47</midino>
                <options>
                    <script-binding/>
                </options>
            </control>
            <control>
                <description>Browse (encoder)</description>
                <group>[Library]</group>
                <key>PicoDJ.browse</key>
                <status>0xB0</status>
                <midino>0x1E</midino>
                <options>
                    <script-binding/>
                </options>
            </control>
            <control>
                <description>Encoder push: switch tree / track list</description>
                <group>[Library]</group>
                <key>MoveFocusForward</key>
                <status>0x90</status>
                <midino>0x4B</midino>
                <options>
                    <normal/>
                </options>
            </control>
        </controls>
        <outputs>
            <output>
                <group>[Channel1]</group>
                <key>play_indicator</key>
                <status>0x90</status>
                <midino>0x3F</midino>
                <on>0x7F</on>
                <off>0x00</off>
                <minimum>0.5</minimum>
            </output>
            <output>
                <group>[Channel1]</group>
                <key>cue_indicator</key>
                <status>0x90</status>
                <midino>0x3E</midino>
                <on>0x7F</on>
                <off>0x00</off>
                <minimum>0.5</minimum>
            </output>
            <output>
                <group>[Channel1]</group>
                <key>sync_enabled</key>
                <status>0x90</status>
                <midino>0x3D</midino>
                <on>0x7F</on>
                <off>0x00</off>
                <minimum>0.5</minimum>
            </output>
            <output>
                <group>[Channel2]</group>
                <key>play_indicator</key>
                <status>0x90</status>
                <midino>0x45</midino>
                <on>0x7F</on>
                <off>0x00</off>
                <minimum>0.5</minimum>
            </output>
            <output>
                <group>[Channel2]</group>
                <key>cue_indicator</key>
                <status>0x90</status>
                <midino>0x44</midino>
                <on>0x7F</on>
                <off>0x00</off>
                <minimum>0.5</minimum>
            </output>
            <output>
                <group>[Channel2]</group>
                <key>sync_enabled</key>
                <status>0x90</status>
                <midino>0x41</midino>
                <on>0x7F</on>
                <off>0x00</off>
                <minimum>0.5</minimum>
            </output>
            <output>
                <group>[EffectRack1_EffectUnit1_Effect1]</group>
                <key>enabled</key>
                <status>0x90</status>
                <midino>0x48</midino>
                <on>0x7F</on>
                <off>0x00</off>
                <minimum>0.5</minimum>
            </output>
            <output>
                <group>[EffectRack1_EffectUnit2_Effect1]</group>
                <key>enabled</key>
                <status>0x90</status>
                <midino>0x47</midino>
                <on>0x7F</on>
                <off>0x00</off>
                <minimum>0.5</minimum>
            </output>
        </outputs>
    </controller>
</MixxxControllerPreset>
